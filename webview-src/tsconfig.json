{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@nerzhulart/webview-sdk": ["packages/api/src/index.ts"],
      "@nerzhulart/webview-sdk/runtime": ["packages/runtime/src/index.ts"],
      "@nerzhulart/webview-sdk/vite": ["packages/build/src/index.ts"]
    }
  },
  "include": ["build.ts", "packages/**/*.ts", "packages/**/*.mts"]
}
